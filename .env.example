ENVIRONMENT=development
PORT=8000

# REQUIRED. Long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`
# The app refuses to start in production with the built-in default.
SECRET_KEY=change_me_to_a_long_random_string

# Optional. Fernet key(s) used to encrypt stored OAuth tokens / session keys /
# webhook secrets. Comma-separate several keys to rotate (the first one is
# used for new values). If empty, a key is derived from SECRET_KEY, so
# changing SECRET_KEY would then make stored tokens unreadable.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Redis password (required by docker-compose)
REDIS_PASSWORD=change_me_redis_password

# Reverse proxy IPs trusted to set X-Forwarded-For (used for rate limiting)
FORWARDED_ALLOW_IPS=127.0.0.1

# Database
# For SQLite (default development):
# DATABASE_URL=sqlite:///./sql_app.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://postgres:default_secure_password_please_change@db/veinmusic
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=default_secure_password_please_change   (required by docker-compose)
# POSTGRES_DB=veinmusic

# Frontend URL (for CORS and OAuth redirect)
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Last.fm (Required for import and scrobbling)
LASTFM_API_KEY=your_lastfm_api_key
LASTFM_API_SECRET=your_lastfm_api_secret

# Spotify (Required for OAuth)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:8000/auth/spotify/callback

# Web Push (optional; push is disabled when empty).
# Generate a key pair: python -m app.services.push_notifications
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@music.vein.guru

# Logging / error reporting
LOG_LEVEL=INFO
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# Spotify/Yandex polling inside the API process (1) or only in the arq worker (0)
RUN_CLOUD_POLLING=1
