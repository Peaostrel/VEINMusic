ENVIRONMENT=development
PORT=8000

# Database
# For SQLite (default development):
# DATABASE_URL=sqlite:///./sql_app.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://postgres:default_secure_password_please_change@db/veinmusic
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=default_secure_password_please_change
# POSTGRES_DB=veinmusic

# Frontend URL (for CORS and OAuth redirect)
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Last.fm (Required for import and scrobbling)
LASTFM_API_KEY=your_lastfm_api_key
LASTFM_API_SECRET=your_lastfm_api_secret

# Spotify (Required for OAuth)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:8000/auth/spotify/callback
