# Provider-neutral S3: use the bucket endpoint supplied by your provider.
# Examples include Yandex Object Storage, Backblaze B2 and other S3 services.
RESTIC_REPOSITORY=s3:https://s3.example.com/your-bucket/veinmusic
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
OFFSITE_INTERVAL_SEC=86400
OFFSITE_RETRY_SEC=60
# Password is read from backup-password.txt via a Docker secret.
# Keep another copy of the password and TOKEN_ENCRYPTION_KEY outside this server.
