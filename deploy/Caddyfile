# Automatic HTTPS (Let's Encrypt) for the site and the API.
# Domains come from deploy/.env: SITE_DOMAIN, API_DOMAIN, ACME_EMAIL.
{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy frontend:3000
}

{$API_DOMAIN} {
	encode zstd gzip
	# Avatar and cover uploads; the API enforces its own smaller limits
	request_body {
		max_size 20MB
	}
	# WebSockets (rooms, live status) are proxied as-is
	reverse_proxy backend:8000
}
