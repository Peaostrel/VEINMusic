# Production settings for deploy/docker-compose.yml.
# deploy.sh copies this file to .env on the first run and fills in every
# secret marked "generated"; the rest you set by hand.

# Domains (DNS A records must point at this server)
SITE_DOMAIN=music.vein.guru
API_DOMAIN=api.music.vein.guru
# Let's Encrypt account e-mail (certificate expiry notices)
ACME_EMAIL=

# Image tag from GitHub Container Registry: "latest" or a commit SHA
IMAGE_TAG=latest

# Database
POSTGRES_USER=postgres
POSTGRES_DB=veinmusic
POSTGRES_PASSWORD=generated

# Secrets (generated)
SECRET_KEY=generated
TOKEN_ENCRYPTION_KEY=generated
REDIS_PASSWORD=generated

# Web Push (generated on the first deploy)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@music.vein.guru

# Integrations (optional)
LASTFM_API_KEY=
LASTFM_API_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SENTRY_DSN=

# Backups kept in the db_backups volume
BACKUP_KEEP_DAYS=7
