{
  "manifest_version": 3,
  "name": "VEIN Music Tracker",
  "version": "1.3.2",
  "description": "Универсальный скроблер треков для VEIN Music.",
  
  "browser_specific_settings": {
    "gecko": {
      "id": "vein-tracker@vein.music",
      "strict_min_version": "109.0"
    }
  },

  "permissions": [
    "storage",
    "tabs",
    "cookies"
  ],

  "host_permissions": [
    "*://*.yandex.ru/*",
    "*://*.spotify.com/*",
    "*://*.youtube.com/*",
    "*://*.vk.com/*",
    "*://*.soundcloud.com/*",
    "*://*.apple.com/*",
    "*://localhost/*",
    "*://127.0.0.1/*",
    "*://music.vein.guru/*"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "*://music.yandex.ru/*",
        "*://*.spotify.com/*",
        "*://music.youtube.com/*",
        "*://vk.com/*",
        "*://soundcloud.com/*",
        "*://music.apple.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["page_world.js"],
      "matches": ["<all_urls>"]
    }
  ]
}